#!/bin/sh
# Starts PleatView with the computer, full screen.
#
#   sudo pleatview-kiosk enable [USER]   no desktop (Ubuntu Server, Raspberry Pi OS Lite): run it in
#                                        cage, a kiosk compositor, on the first console, as USER
#   pleatview-kiosk autostart            a desktop (Ubuntu, Raspberry Pi OS): open it when you log in
#   sudo pleatview-kiosk disable         undo either
#   pleatview-kiosk connect URL          connect out to a controller at URL (wss://…) and show
#                                        the code to add this screen there with
#   sudo pleatview-kiosk upkeep [USER]   let its controller restart this computer and update
#                                        PleatView (enable does this too)
set -eu

unit=/etc/systemd/system/pleatview-kiosk.service

usage() {
  sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}

need_root() {
  [ "$(id -u)" -eq 0 ] || { echo "Run this with sudo." >&2; exit 1; }
}

# Lets a controller restart this computer and update pleatview (docs/protocol.md, "Upkeep"):
# the app asks the helper, which runs as root and takes nothing else.
upkeep() {
  need_root
  user=$1
  getent group pleatview >/dev/null || groupadd --system pleatview
  usermod -aG pleatview "$user"
  cat >/etc/tmpfiles.d/pleatview.conf <<TMPFILES
d /run/pleatview 0750 root pleatview -
d /run/pleatview/requests 0770 root pleatview -
TMPFILES
  systemd-tmpfiles --create /etc/tmpfiles.d/pleatview.conf
  cat >/etc/systemd/system/pleatview-helper.path <<PATHUNIT
[Unit]
Description=PleatView: its controller's requests to restart or update this computer

[Path]
DirectoryNotEmpty=/run/pleatview/requests

[Install]
WantedBy=paths.target
PATHUNIT
  cat >/etc/systemd/system/pleatview-helper.service <<SERVICE
[Unit]
Description=PleatView: restart or update this computer, as its controller asked

[Service]
Type=oneshot
ExecStart=/usr/lib/pleatview/helper pleatview
TimeoutStartSec=30min
SERVICE
  systemctl daemon-reload
  systemctl enable --now pleatview-helper.path >/dev/null 2>&1
}

no_upkeep() {
  systemctl disable --now pleatview-helper.path >/dev/null 2>&1 || true
  rm -f /etc/systemd/system/pleatview-helper.path /etc/systemd/system/pleatview-helper.service /etc/tmpfiles.d/pleatview.conf
  rm -rf /run/pleatview
  systemctl daemon-reload
}

enable() {
  need_root
  user=${1:-${SUDO_USER:-}}
  [ -n "$user" ] && [ "$user" != root ] || { echo "Name the user to run PleatView as: sudo pleatview-kiosk enable USER" >&2; exit 1; }
  id "$user" >/dev/null 2>&1 || { echo "No user called $user." >&2; exit 1; }
  command -v cage >/dev/null 2>&1 || { echo "cage isn't installed: sudo apt install cage" >&2; exit 1; }
  # The screen, input devices and sound.
  for group in video render input audio; do getent group "$group" >/dev/null && usermod -aG "$group" "$user"; done
  cat >"$unit" <<EOF
[Unit]
Description=PleatView on this screen
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=$user
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStart=/usr/bin/cage -s -d -- /usr/bin/pleatview
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
EOF
  systemctl daemon-reload
  systemctl disable --now getty@tty1.service >/dev/null 2>&1 || true
  systemctl set-default graphical.target >/dev/null
  upkeep "$user"
  systemctl enable --now pleatview-kiosk.service
  echo "PleatView now starts with the computer, as $user. Logs: journalctl -u pleatview-kiosk"
}

allow_upkeep() {
  need_root
  user=${1:-${SUDO_USER:-}}
  [ -n "$user" ] && [ "$user" != root ] || { echo "Name the user PleatView runs as: sudo pleatview-kiosk upkeep USER" >&2; exit 1; }
  id "$user" >/dev/null 2>&1 || { echo "No user called $user." >&2; exit 1; }
  upkeep "$user"
  echo "Its controller can now restart this computer and update PleatView, from $user's next login."
}

autostart() {
  [ "$(id -u)" -ne 0 ] || { echo "Run this as the user who logs in to the desktop, without sudo." >&2; exit 1; }
  dir=${XDG_CONFIG_HOME:-$HOME/.config}/autostart
  mkdir -p "$dir"
  cat >"$dir/pleatview.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=PleatView
Exec=/usr/bin/pleatview
X-GNOME-Autostart-enabled=true
EOF
  # The desktop shouldn't blank the screen while a dashboard is up (PleatView also asks it not to).
  if command -v gsettings >/dev/null 2>&1; then gsettings set org.gnome.desktop.session idle-delay 0 2>/dev/null || true; fi
  if command -v raspi-config >/dev/null 2>&1; then echo "On a Raspberry Pi, also turn off Screen Blanking: sudo raspi-config nonint do_blanking 1"; fi
  echo "PleatView opens when you log in. To skip the login, turn on automatic login in the desktop's settings."
}

disable() {
  need_root
  if [ -f "$unit" ]; then
    systemctl disable --now pleatview-kiosk.service || true
    rm -f "$unit"
    systemctl daemon-reload
    systemctl enable getty@tty1.service >/dev/null 2>&1 || true
  fi
  no_upkeep
  user_home=$(getent passwd "${SUDO_USER:-root}" | cut -d: -f6)
  rm -f "$user_home/.config/autostart/pleatview.desktop"
  echo "PleatView no longer starts with the computer."
}

# The running app does it (protocol v2); its control API takes this from this computer only.
connect() {
  [ -n "${1:-}" ] || usage
  python3 - "$1" "${PLEATVIEW_PORT:-8765}" <<'PY'
import json, sys, urllib.error, urllib.request
request = urllib.request.Request(f"http://127.0.0.1:{sys.argv[2]}/api/connect", method="POST",
                                 data=json.dumps({"url": sys.argv[1]}).encode(), headers={"Content-Type": "application/json"})
try:
    urllib.request.urlopen(request, timeout=5).close()
except urllib.error.HTTPError as err:
    sys.exit(json.loads(err.read() or b"{}").get("error", str(err)))
except OSError as err:
    sys.exit(f"PleatView isn't running here: {err}")
print("The screen now shows a code. Add the screen in the controller with it.")
PY
}

case "${1:-}" in
  enable) shift; enable "${1:-}" ;;
  connect) shift; connect "${1:-}" ;;
  upkeep) shift; allow_upkeep "${1:-}" ;;
  autostart) autostart ;;
  disable) disable ;;
  *) usage ;;
esac
