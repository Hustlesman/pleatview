{
  "name": "pleatview",
  "productName": "PleatView",
  "version": "1.0.18",
  "description": "Home Assistant dashboards, media and notifications on a screen, controlled by Home Assistant",
  "homepage": "https://pleatview.hustlesman.com",
  "author": "Hustlesman <privacy@hustlesman.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "assets": "node scripts/copy-assets.js",
    "start": "npm run assets && electron .",
    "dist": "npm run assets && electron-builder --linux deb --x64 --arm64"
  },
  "dependencies": {
    "@homebridge/ciao": "^1.4.0",
    "hls.js": "^1.6.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "overrides": {
    "minimatch@^9.0.0": "^11.0.5",
    "minimatch@^10.0.0": "^11.0.5"
  },
  "build": {
    "appId": "com.hustlesman.pleatview",
    "productName": "PleatView",
    "executableName": "pleatview",
    "artifactName": "pleatview_${version}_${arch}.${ext}",
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "linux": {
      "category": "Utility",
      "icon": "build/icon.png",
      "synopsis": "Home Assistant dashboards on this screen",
      "maintainer": "Hustlesman <privacy@hustlesman.com>",
      "vendor": "Hustlesman",
      "desktop": {
        "entry": {
          "Name": "PleatView",
          "Comment": "Home Assistant dashboards, media and notifications on this screen"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnss3",
        "libxss1",
        "libxtst6",
        "libasound2t64 | libasound2",
        "libgbm1"
      ],
      "recommends": [
        "cage",
        "wlopm",
        "wlr-randr",
        "v4l-utils"
      ],
      "fpm": [
        "build/pleatview-kiosk=/usr/bin/pleatview-kiosk",
        "build/pleatview-helper=/usr/lib/pleatview/helper",
        "build/release-cert.pem=/usr/lib/pleatview/release-cert.pem"
      ]
    }
  },
  "desktopName": "pleatview.desktop"
}
