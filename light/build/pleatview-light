#!/bin/sh
# Sets up PleatView Light, which plays the dashboards Home Assistant renders, full screen.
#
#   sudo pleatview-light enable [USER]   start it with the computer, as USER (default: you),
#                                        and let its controller restart and update it
#   sudo pleatview-light disable         stop starting it
#   pleatview-light pin                  show the screen's pairing PIN (also on screen)
#   pleatview-light connect URL          connect out to a controller at URL (wss://…) and
#                                        show the code to add the screen there with
#
# It takes over the screen's display (no desktop needed) and port 8765.
set -eu

unit=/etc/systemd/system/pleatview-light.service

usage() {
  sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}

need_root() {
  [ "$(id -u)" -eq 0 ] || { echo "Run this with sudo." >&2; exit 1; }
}

# Lets a controller restart this computer and update pleatview-light (docs/protocol.md, "Upkeep"):
# the app asks the helper, which runs as root and takes nothing else.
upkeep() {
  need_root
  user=$1
  getent group pleatview >/dev/null || groupadd --system pleatview
  usermod -aG pleatview "$user"
  cat >/etc/tmpfiles.d/pleatview-light.conf <<TMPFILES
d /run/pleatview-light 0750 root pleatview -
d /run/pleatview-light/requests 0770 root pleatview -
TMPFILES
  systemd-tmpfiles --create /etc/tmpfiles.d/pleatview-light.conf
  cat >/etc/systemd/system/pleatview-light-helper.path <<PATHUNIT
[Unit]
Description=PleatView: its controller's requests to restart or update this computer

[Path]
DirectoryNotEmpty=/run/pleatview-light/requests

[Install]
WantedBy=paths.target
PATHUNIT
  cat >/etc/systemd/system/pleatview-light-helper.service <<SERVICE
[Unit]
Description=PleatView: restart or update this computer, as its controller asked

[Service]
Type=oneshot
ExecStart=/usr/share/pleatview-light/helper pleatview-light
TimeoutStartSec=30min
SERVICE
  systemctl daemon-reload
  systemctl enable --now pleatview-light-helper.path >/dev/null 2>&1
}

no_upkeep() {
  systemctl disable --now pleatview-light-helper.path >/dev/null 2>&1 || true
  rm -f /etc/systemd/system/pleatview-light-helper.path /etc/systemd/system/pleatview-light-helper.service /etc/tmpfiles.d/pleatview-light.conf
  rm -rf /run/pleatview-light
  systemctl daemon-reload
}

enable() {
  need_root
  user=${1:-${SUDO_USER:-}}
  [ -n "$user" ] && [ "$user" != root ] || { echo "Name the user to run it as: sudo pleatview-light enable USER" >&2; exit 1; }
  id "$user" >/dev/null 2>&1 || { echo "No user called $user." >&2; exit 1; }
  for group in video render audio; do getent group "$group" >/dev/null && usermod -aG "$group" "$user"; done
  # The Electron app's kiosk would hold the display and port 8765.
  systemctl disable --now pleatview-kiosk.service >/dev/null 2>&1 || true
  cat >"$unit" <<UNIT
[Unit]
Description=PleatView Light on this screen
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=$user
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/pleatview-light
ExecStart=/usr/bin/python3 -m pleatview_light
WorkingDirectory=/usr/share/pleatview-light
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT
  systemctl daemon-reload
  systemctl disable --now getty@tty1.service >/dev/null 2>&1 || true
  upkeep "$user"
  systemctl enable --now pleatview-light.service
  echo "PleatView Light now starts with the computer, as $user. Logs: journalctl -u pleatview-light"
}

disable() {
  need_root
  systemctl disable --now pleatview-light.service >/dev/null 2>&1 || true
  rm -f "$unit"
  no_upkeep
  systemctl enable --now getty@tty1.service >/dev/null 2>&1 || true
  echo "PleatView Light no longer starts with the computer."
}

case "${1:-}" in
  enable) shift; enable "$@" ;;
  disable) disable ;;
  connect) shift; [ $# -eq 1 ] || usage; cd /usr/share/pleatview-light && exec /usr/bin/python3 -m pleatview_light connect "$1" ;;
  pin) journalctl -u pleatview-light -n 200 --no-pager -o cat 2>/dev/null | grep -o 'PIN [0-9 ]*' | tail -1 || echo "Not running." ;;
  *) usage ;;
esac
