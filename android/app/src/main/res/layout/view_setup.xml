<?xml version="1.0" encoding="utf-8"?>
<!-- Scrolls when the screen is short (a phone on its side). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <!-- Side by side on TVs and wide screens; MainActivity stacks them on narrow ones. -->
    <LinearLayout
        android:id="@+id/setup_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="24dp">

    <LinearLayout
        android:id="@+id/setup_text"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/accent"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="@string/setup_tagline"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_step_discover"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/setup_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="22dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setup_pin_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_step_pin"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/setup_pin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="26dp"
            android:background="@drawable/pin_box"
            android:fontFamily="monospace"
            android:letterSpacing="0.25"
            android:paddingStart="26dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"
            android:textColor="@color/text_primary"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setup_manual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/setup_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- No Home Assistant yet: a sample home and a tour. Focused on TVs, so OK starts it. -->
        <Button
            android:id="@+id/setup_demo"
            style="@style/PleatView.MenuButton"
            android:layout_width="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/setup_demo" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/setup_code"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/setup_qr"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:importantForAccessibility="yes"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setup_qr_caption"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>
    </LinearLayout>
</ScrollView>
