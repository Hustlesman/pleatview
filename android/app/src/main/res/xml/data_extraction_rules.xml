<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the TV: the settings hold the Home Assistant access token, and the web
     view's storage holds the sites' sessions. android:allowBackup="false" doesn't stop
     device-to-device transfers on Android 12 and later; these rules do. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
